# ============================================================
# 项目专属（优先级最高）
# ============================================================

# 运行数据（含加密的服务器凭据与账号哈希，严禁入库）
data/

# 发布产物与构建缓存（由 pack.py 生成/下载）
build_cache/
*.zip
*.tar.gz
*.log

# 便携运行时（大二进制，由 pack.py 按需下载构建）
runtime*/

# ============================================================
# Python 通用（GitHub 官方模板，已去掉与本项目无关的框架段落）
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
wheels/
*.egg-info/
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
# .python-version

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre / pytype checkers
.pyre/
.pytype/

# Cython debug symbols
cython_debug/

# JetBrains / VS Code（按需取消注释以忽略整个 IDE 目录）
# .idea/
# .vscode/

# Ruff
.ruff_cache/

# PyPI configuration file
.pypirc

# 临时执行文件
tempCodeRunnerFile.py
